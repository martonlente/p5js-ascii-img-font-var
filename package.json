{
  "name": "p5js-ascii-img-font-var",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "css": "npm-run-all css-compile css-prefix",
    "css-compile": "sass --no-source-map scss:css-compiled",
    "css-prefix": "postcss css-compiled/*.css --use autoprefixer --no-map -d css-compiled/",
    "serve": "browser-sync start --server --files \"css-compiled/*.css, *.html, js/*.js, scss/*.scss\"",
    "watch": "nodemon --exec \"npm run css\" --ext scss --watch scss"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martonlente/p5js-ascii-img-font-var.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/martonlente/p5js-ascii-img-font-var/issues"
  },
  "homepage": "https://github.com/martonlente/p5js-ascii-img-font-var#readme",
  "dependencies": {
    "p5": "^2.2.3",
    "p5.sound": "^0.3.0",
    "reset-css": "^5.0.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "browser-sync": "^3.0.4",
    "nodemon": "^3.1.7",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^11.0.0",
    "sass": "^1.81.0"
  }
}
